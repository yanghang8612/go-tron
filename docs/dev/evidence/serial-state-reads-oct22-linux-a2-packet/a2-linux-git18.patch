diff --git a/core/rawdb/direct_history_cursor.go b/core/rawdb/direct_history_cursor.go
new file mode 100644
--- /dev/null
+++ b/core/rawdb/direct_history_cursor.go
@@ -0,0 +1,39 @@
+package rawdb
+
+import (
+	"errors"
+
+	"github.com/tronprotocol/go-tron/core/pointread"
+)
+
+// Open both cursors on the already pinned dual-engine snapshot. Routing stays
+// identical to directHistorySnapshot.Get, including non-storage/history keys.
+func (s *directHistorySnapshot) NewPointReadCursor() (pointread.Cursor, error) {
+	hotFactory, hotOK := s.hot.(pointread.KeyValueCursorSnapshot)
+	historyFactory, historyOK := s.history.(pointread.KeyValueCursorSnapshot)
+	if !hotOK || !historyOK {
+		return nil, pointread.ErrPointReadCursorUnsupported
+	}
+	hot, err := hotFactory.NewPointReadCursor()
+	if err != nil {
+		return nil, err
+	}
+	history, err := historyFactory.NewPointReadCursor()
+	if err != nil {
+		return nil, errors.Join(err, hot.Close())
+	}
+	return &directHistoryKeyValueCursor{hot: hot, history: history}, nil
+}
+
+type directHistoryKeyValueCursor struct{ hot, history pointread.Cursor }
+
+func (c *directHistoryKeyValueCursor) View(key []byte, fn func([]byte) error) (bool, error) {
+	if IsDirectHistoryKey(key) {
+		return c.history.View(key, fn)
+	}
+	return c.hot.View(key, fn)
+}
+
+func (c *directHistoryKeyValueCursor) Close() error {
+	return errors.Join(c.hot.Close(), c.history.Close())
+}
diff --git a/core/rawdb/pebbledb/storage_cursor.go b/core/rawdb/pebbledb/storage_cursor.go
new file mode 100644
--- /dev/null
+++ b/core/rawdb/pebbledb/storage_cursor.go
@@ -0,0 +1,54 @@
+package pebbledb
+
+import (
+	"errors"
+	"github.com/cockroachdb/pebble"
+	"github.com/tronprotocol/go-tron/core/pointread"
+)
+
+var storageCursorMetrics = newGetCursorMetrics("blockbuffer/storage_read/pebble/get_cursor/", "retained_peak_sum")
+
+// A foreground storage cursor has its own metrics and owner. It must never be
+// counted as a prefetch cursor, nor be reused with a moving database sequence.
+type storagePointCursor struct{ inner *pebble.GetCursor }
+
+func (s *keyValueSnapshot) NewPointReadCursor() (pointread.Cursor, error) {
+	if s == nil || s.snapshot == nil {
+		return nil, pebble.ErrClosed
+	}
+	// Keep ordinary DB.Get's filter policy. This candidate changes iterator
+	// lifetime only, not L6 filter selection or table lookup semantics.
+	c, err := s.snapshot.NewGetCursor()
+	if err != nil {
+		return nil, err
+	}
+	return &storagePointCursor{inner: c}, nil
+}
+
+func (c *storagePointCursor) View(key []byte, fn func([]byte) error) (found bool, err error) {
+	if c == nil || c.inner == nil {
+		return false, pebble.ErrClosed
+	}
+	value, err := c.inner.Get(key)
+	if err == pebble.ErrNotFound {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	defer func() {
+		err = errors.Join(err, c.inner.ReleaseValue())
+	}()
+	return true, fn(value)
+}
+
+func (c *storagePointCursor) Close() error {
+	if c == nil || c.inner == nil {
+		return nil
+	}
+	inner := c.inner
+	c.inner = nil
+	err := inner.Close()
+	storageCursorMetrics.observe(inner.Stats())
+	return err
+}
