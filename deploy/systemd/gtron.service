[Unit]
Description=gtron mainnet snap node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=java-tron
Group=java-tron
WorkingDirectory=/data/gtron/main
UMask=0027

Environment=TZ=Asia/Shanghai
Environment=ZCASH_PARAMS_DIR=/data/gtron/params

# Optional signed snapshot publisher/HTTP seed settings. Keep this environment
# file root-owned 0600 and the referenced Ed25519 key root:java-tron 0640; never
# put key material in ExecStart or this template.
# See docs/dev/snapshot-bootstrap.md for the exact variables.
EnvironmentFile=-/etc/gtron/snapshot.env

# Go runtime
Environment=GOMEMLIMIT=10GiB
Environment=GOGC=200

# Async commit pipeline
Environment=GTRON_ASYNC_COMMIT_DEPTH=4

ExecStart=/data/gtron/go-tron/build/bin/gtron \
    --datadir /data/gtron/main/datadir \
    --prune.mode snap \
    --sync.async-commit \
    --sync.import-batch 32 \
    --p2p.port 18890 \
    --external.ip 3.12.206.71 \
    --exec.parallel-transfers \
    --http.port 8090 \
    --jsonrpc.port 8545 \
    --grpc.port 50051 \
    --pprof.port 6062 \
    --pprof.addr 127.0.0.1 \
    --metrics \
    --metrics.addr 127.0.0.1 \
    --metrics.port 6071 \
    --maxpeers 30 \
    --db.cache 16384 \
    --db.handles 8192 \
    --db.memtable 256 \
    --db.target-file-size 8 \
    --db.lbase-max-size 1024 \
    --db.l0.compact 8 \
    --db.l0.stop 64 \
    --state.trie.cache 128 \
    --state.commitment.cache 512 \
    --log.format terminal \
    --verbosity 3 \
    --log.file /data/gtron/main/gtron.log \
    --log.file.format terminal \
    --log.file.verbosity 3 \
    --log.file.max-size 100 \
    --log.file.max-backups 3 \
    --log.file.max-age 28 \
    --log.file.compress

# 控制台日志交给 journald；命令行格式文件由 gtron 自身轮转。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gtron

Restart=always
RestartSec=10

TimeoutStopSec=300
KillSignal=SIGTERM

LimitNOFILE=65536

# CentOS 7 / old systemd
MemorySoftLimit=28G
MemoryLimit=32G

[Install]
WantedBy=multi-user.target
