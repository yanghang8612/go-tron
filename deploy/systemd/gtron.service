[Unit]
Description=gtron mainnet snap node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=java-tron
Group=java-tron
WorkingDirectory=/data/gtron/main
UMask=0027

# Bound repeated startup failures instead of continuously reopening a damaged
# or incompatible database. systemd 219 (CentOS 7) accepts these in [Service].
StartLimitInterval=300
StartLimitBurst=5

Environment=TZ=Asia/Shanghai
Environment=ZCASH_PARAMS_DIR=/data/gtron/params

# Optional signed snapshot publisher/HTTP seed settings. Keep this environment
# file root-owned 0600 and the referenced Ed25519 key root:java-tron 0640; never
# put key material in ExecStart or this template.
# See docs/dev/snapshot-bootstrap.md for the exact variables.
EnvironmentFile=-/etc/gtron/snapshot.env

# Go runtime
Environment=GOMEMLIMIT=8GiB
Environment=GOGC=100

# Async commit pipeline
Environment=GTRON_ASYNC_COMMIT_DEPTH=4

ExecStart=/data/gtron/go-tron/build/bin/gtron \
    --datadir /data/gtron/main/datadir \
    --prune.mode snap \
    --sync.async-commit \
    --p2p.port 18890 \
    --external.ip 3.12.206.71 \
    --exec.parallel-transfers \
    --http.port 8090 \
    --jsonrpc.port 8545 \
    --grpc.port 50051 \
    --pprof.port 6062 \
    --pprof.addr 127.0.0.1 \
    --metrics \
    --metrics.addr 127.0.0.1 \
    --metrics.port 6071 \
    --maxpeers 30 \
    --db.cache 4096 \
    --db.handles 8192 \
    --state.trie.cache 128 \
    --log.file /data/gtron/main/gtron.log \
    --log.file.format terminal

# 控制台日志交给 journald；命令行格式文件由 gtron 自身轮转。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gtron

# A clean operator/systemd stop must stay stopped for maintenance. Deployment
# jobs explicitly start the service again; only unexpected exits auto-restart.
Restart=on-failure
RestartSec=15

# Large snapshot/ETL passes need time to cancel and close Pebble cleanly.
TimeoutStopSec=600
KillSignal=SIGTERM

LimitNOFILE=131072

# CentOS 7 / systemd 219: MemorySoftLimit is unsupported. The 32 GiB hard
# limit is the selected mainnet cold-history budget. Keep the Go
# runtime soft limit and Pebble cache at the deployed 8 GiB / 4 GiB values;
# these are not additive RSS bounds. See docs/dev/mainnet-memory-budget-20260930.md.
MemoryLimit=32G

[Install]
WantedBy=multi-user.target
